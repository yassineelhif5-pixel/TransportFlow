# Copier ce fichier en .env (jamais commité) puis adapter les valeurs.

# Mot de passe du compte « sa » SQL Server (8 caractères min., majuscule, minuscule, chiffre, symbole)
SQL_SA_PASSWORD=TransportFlow_Dev2026!

# Clé de signature des JWT : 32 caractères minimum, aléatoire, différente par environnement
JWT_SECRET=remplacez-moi-par-une-cle-aleatoire-de-64-caracteres

# Environnement de l'API : Development (admin/admin + données de démo) ou Production
API_ENVIRONMENT=Development

# Compte administrateur initial. En Development, admin/admin si SEED_ADMIN_PASSWORD est vide.
# En Production : obligatoire, 12 caractères minimum, changement forcé à la première connexion.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
