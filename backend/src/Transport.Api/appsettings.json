{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "TransportFlow",
    "Audience": "TransportFlow.Clients",
    "Secret": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage/documents",
    "MaxFileSizeMb": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "DemoData": false
  }
}
